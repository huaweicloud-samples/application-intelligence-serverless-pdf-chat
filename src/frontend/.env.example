# Front-end environment variables (copy to .env and fill in).
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# APIG stage base URL, e.g. https://<group-id>.apig.<region>.huaweicloudapis.com/<stage>/
VITE_API_ENDPOINT=

# (Optional) APIG simple App authentication AppCode. When the API is protected
# by App authentication in "AppCode" mode, set it here; the client sends it as
# the X-Apig-AppCode header. Leave empty if App authentication is disabled.
VITE_APIG_APP_CODE=
